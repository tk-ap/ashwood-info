:root {
  --ink: #f0eee7;
  --paper: #090909;
  --muted: #8d8d86;
  --line: rgba(240, 238, 231, .28);
  --green: #c49a45;
  --magenta: #9b3f50;
  --heritage-green: #c49a45;
  --max: 1640px;
  --gutter: clamp(18px, 3vw, 52px);
  --section-gap: clamp(96px, 13vw, 210px);
  --display: "Helvetica Neue", Helvetica, Arial, sans-serif;
  --display-size: clamp(54px, 10vw, 132px);
  --display-line: .9;
  --display-tracking: -.055em;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--display); text-rendering: optimizeLegibility; overflow-x: clip; }
a { color: inherit; }
img { max-width: 100%; display: block; }
.skip-link { position: fixed; left: 12px; top: 12px; transform: translateY(-150%); z-index: 100; background: var(--ink); color: var(--paper); padding: 10px 14px; text-decoration: none; }
.skip-link:focus { transform: none; }
.site-header { position: sticky; top: 0; z-index: 50; display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 18px var(--gutter); border-bottom: 1px solid rgba(240, 238, 231, .12); background: rgba(9, 9, 9, .9); backdrop-filter: blur(12px); }
.brand { font-size: 13px; font-weight: 700; letter-spacing: .16em; text-decoration: none; }
.site-nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 10px clamp(16px, 2vw, 34px); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; }
.site-nav a { text-decoration: none; }
.site-nav a:hover,.site-nav a:focus-visible { text-decoration: underline; text-underline-offset: 5px; }
.site-nav a[aria-current="page"] { color: var(--green); }
.section-shell { width: min(100%, var(--max)); margin-inline: auto; padding-inline: var(--gutter); }
.hero {
  position: relative;
  min-height: calc(100vh - 61px);
  display: grid;
  grid-template-rows: 1fr auto;
  align-items: end;
  gap: 0;
  padding-top: clamp(24px, 3vw, 48px);
  padding-bottom: 30px;
}
.hero-copy {
  position: relative;
  z-index: 2;
  align-self: end;
  width: min(720px, 70%);
  min-width: 0;
  padding: clamp(80px, 12vw, 170px) 0 clamp(40px, 7vw, 90px);
}


.hero-media {
  position: absolute;
  inset: 0;
  z-index: 0;
  min-height: 0;
  aspect-ratio: auto;
  padding: 0;
  border: 0;
  background: none;
}

.hero-media::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      90deg,
      rgba(9, 9, 9, .72) 0%,
      rgba(9, 9, 9, .30) 42%,
      rgba(9, 9, 9, .08) 72%,
      rgba(9, 9, 9, .12) 100%
    ),
    linear-gradient(
      0deg,
      rgba(9, 9, 9, .70) 0%,
      transparent 55%
    );
  pointer-events: none;
}

.hero-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}
.microcopy,.section-kicker,.asset-frame span,.section-note,.credit,.music-index,.contact-grid span,.experience-list span,.detail-list dt,.footer-meta,.portfolio-footer nav,.portfolio-footer small { font-size: 10px; line-height: 1.35; letter-spacing: .12em; text-transform: uppercase; }
.microcopy { color: var(--muted); margin: 0 0 28px; }
.hero h1 { margin: 0; font-size: var(--display-size); line-height: var(--display-line); letter-spacing: var(--display-tracking); font-weight: 500; max-width: 760px; text-wrap: balance; }
.hero h1 span { display: block; color: var(--green); }
.hero-deck { max-width: 520px; margin: 30px 0 0; font-size: clamp(18px, 2vw, 30px); line-height: 1.18; letter-spacing: -.025em; }
.hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 18px 30px; margin-top: 34px; }
.button { display: inline-flex; min-height: 44px; align-items: center; justify-content: center; padding: 13px 18px; border: 1px solid currentColor; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; text-decoration: none; }
.button-primary { background: var(--green); color: #080808; border-color: var(--green); }
.text-link { display: inline-block; padding: 8px 0 5px; border-bottom: 1px solid currentColor; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; text-decoration: none; }
.scroll-cue { grid-column: 1 / -1; justify-self: start; color: var(--muted); font-size: 9px; letter-spacing: .12em; text-transform: uppercase; text-decoration: none; }
.asset-frame { overflow: hidden; display: flex; min-width: 0; align-items: end; justify-content: flex-start; padding: 14px; border: 1px solid rgba(240, 238, 231, .18); background: linear-gradient(145deg, rgba(255,255,255,.045), rgba(255,255,255,.005)), repeating-linear-gradient(90deg, transparent 0 31px, rgba(255,255,255,.022) 31px 32px); color: rgba(240, 238, 231, .5); }
.asset-frame img { display: block; width: 100%; height: 100%; object-fit: cover; }
.asset-frame-portrait { min-height: min(72vh, 900px); aspect-ratio: 4 / 5; }
.asset-frame-tall { aspect-ratio: 3 / 4; }
.asset-frame-square { aspect-ratio: 1; }
.asset-frame-wide { aspect-ratio: 16 / 9; }
.asset-frame-landscape { aspect-ratio: 4 / 3; }
.muted-asset { opacity: .72; }
.statement { padding-top: var(--section-gap); padding-bottom: var(--section-gap); }
.statement p { width: min(100%, 12ch); margin: 0; font-size: clamp(54px, 8vw, 138px); line-height: .94; letter-spacing: -.055em; font-weight: 650; }
.statement span { color: var(--magenta); }
.feature-section,.work-section,.runway-section,.about-section,.details-section,.experience-section,.music-section,.contact-section { padding-top: var(--section-gap); padding-bottom: var(--section-gap); border-top: 1px solid var(--line); }
.about-section,.details-section { padding-top: clamp(28px, 4vw, 64px); }
.section-kicker { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px 30px; color: var(--muted); margin-bottom: clamp(38px, 6vw, 84px); }
.section-kicker span:first-child { color: var(--heritage-green); }
.feature-heading { display: grid; grid-template-columns: minmax(0, 1fr) minmax(220px, 360px); align-items: end; gap: 32px; }
.outline-title { margin: 0; font-size: clamp(64px, 10vw, 180px); line-height: .82; letter-spacing: -.08em; font-weight: 800; color: transparent; -webkit-text-stroke: 1.5px var(--ink); text-transform: uppercase; white-space: nowrap; }
.feature-intro { padding-bottom: 8px; }
.feature-intro p { margin: 0; font-size: 18px; line-height: 1.35; }
.feature-intro .credit { margin-top: 18px; color: var(--muted); }
.campaign-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: clamp(12px, 1.4vw, 22px); margin-top: clamp(54px, 8vw, 110px); }
.campaign-grid > :nth-child(1) { grid-column: 1 / -1; }
.campaign-grid > :nth-child(2) { grid-column: 1 / span 5; }
.campaign-grid > :nth-child(3) { grid-column: 8 / -1; align-self: end; }
.campaign-grid > :nth-child(4) { grid-column: 3 / span 7; }
.campaign-grid > :nth-child(5) { grid-column: 8 / -1; }
.campaign-grid > :nth-child(6) { grid-column: 1 / span 4; align-self: end; }
.section-note { color: var(--muted); max-width: 620px; margin: 34px 0 0; }
.split-heading { display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, 520px); gap: 30px; align-items: end; }
.split-heading h2,.about-layout h2,.details-layout h2,.experience-section h2,.music-section h2,.contact-section h2 { margin: 0; font-size: clamp(56px, 9vw, 145px); line-height: .86; letter-spacing: -.06em; font-weight: 700; }
.split-heading p,.about-layout p,.details-layout p,.music-layout p { margin: 0; font-size: clamp(17px, 1.6vw, 24px); line-height: 1.42; color: #d7d4cc; }
.archive-grid,.runway-strip,.digitals-grid { display: grid; gap: clamp(12px, 1.4vw, 22px); margin-top: clamp(54px, 8vw, 110px); }
.archive-grid { grid-template-columns: 1.2fr .8fr; align-items: start; }
.archive-grid > :nth-child(3) { grid-column: 1 / -1; width: 72%; margin-left: auto; }
.runway-strip { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.runway-strip > :nth-child(2) { margin-top: 12vw; }
.about-layout,.details-layout,.music-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(320px, .75fr); gap: clamp(44px, 8vw, 120px); align-items: start; }
.about-layout p,.details-layout p { margin-top: 32px; max-width: 720px; }
.detail-list { margin: 0; border-top: 1px solid var(--line); }
.detail-list div { display: grid; grid-template-columns: minmax(100px, .45fr) 1fr; gap: 20px; padding: 18px 0; border-bottom: 1px solid var(--line); }
.detail-list dt { color: var(--muted); }
.detail-list dd { margin: 0; font-size: 16px; }
.digitals-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.experience-list { margin-top: 56px; border-top: 1px solid var(--line); }
.experience-list div { display: grid; grid-template-columns: minmax(130px, .55fr) 1.2fr 1fr; gap: 22px; padding: 22px 0; border-bottom: 1px solid var(--line); align-items: baseline; }
.experience-list span,.experience-list small { color: var(--muted); }
.experience-list strong { font-size: clamp(20px, 2vw, 30px); font-weight: 500; }
.experience-list small { font-size: 12px; line-height: 1.4; }
.contact-section h2 { max-width: 9ch; }
.contact-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; margin-top: 56px; border-top: 1px solid var(--line); }
.contact-grid div { padding: 20px 0; border-bottom: 1px solid var(--line); }
.contact-grid span { display: block; color: var(--muted); margin-bottom: 8px; }
.contact-grid strong { font-size: clamp(17px, 1.6vw, 24px); font-weight: 500; overflow-wrap: anywhere; }
.contact-button { margin-top: 34px; }
.portfolio-footer { display: grid; grid-template-columns: 1.4fr 1fr auto; gap: 26px; align-items: end; padding-top: 60px; padding-bottom: 28px; border-top: 1px solid var(--line); }
.footer-mark { grid-row: span 2; font-size: clamp(72px, 12vw, 180px); line-height: .75; letter-spacing: -.08em; font-weight: 800; }
.footer-meta { display: grid; gap: 6px; color: var(--muted); }
.portfolio-footer nav { display: flex; flex-wrap: wrap; gap: 16px; }
.portfolio-footer nav a { text-decoration: none; }
.portfolio-footer small { color: var(--muted); }
:focus-visible { outline: 2px solid var(--green); outline-offset: 4px; }
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
@media (max-width: 980px) { .hero { min-height: calc(100vh - 61px); } .hero-copy { width: min(760px, 86%); padding: clamp(90px, 18vw, 150px) 0 clamp(36px, 8vw, 70px); } .hero-media { min-height: 0; } .feature-heading,.split-heading,.about-layout,.details-layout,.music-layout { grid-template-columns: 1fr; } .feature-intro { max-width: 560px; } .campaign-grid > :nth-child(2),.campaign-grid > :nth-child(3),.campaign-grid > :nth-child(4),.campaign-grid > :nth-child(5),.campaign-grid > :nth-child(6) { grid-column: auto; } .campaign-grid { grid-template-columns: 1fr 1fr; } .campaign-grid > :nth-child(1) { grid-column: 1 / -1; } .archive-grid > :nth-child(3) { width: 100%; } .experience-list div { grid-template-columns: 1fr 1.4fr; } .experience-list small { grid-column: 2; } .contact-grid { grid-template-columns: 1fr; } .portfolio-footer { grid-template-columns: 1fr 1fr; } .footer-mark { grid-row: auto; grid-column: 1 / -1; } }
@media (max-width: 640px) { .site-header { align-items: flex-start; } .site-nav { gap: 10px 16px; } .hero { min-height: calc(100svh - 61px); padding-top: 0; padding-bottom: 20px; } .hero-copy { width: 100%; padding: 110px 0 34px; } .hero h1 { font-size: clamp(54px, 15vw, 92px); } .hero-deck { margin-top: 28px; } .hero-media { min-height: 0; } .statement p { font-size: clamp(48px, 16vw, 78px); } .outline-title { font-size: clamp(66px, 23vw, 108px); -webkit-text-stroke-width: 1px; } .campaign-grid,.archive-grid,.runway-strip,.digitals-grid { grid-template-columns: 1fr; } .campaign-grid > *,.archive-grid > *,.runway-strip > * { grid-column: auto !important; margin: 0 !important; width: 100% !important; } .detail-list div,.experience-list div { grid-template-columns: 1fr; } .experience-list small { grid-column: auto; } .portfolio-footer { grid-template-columns: 1fr; } .footer-mark { grid-column: auto; } }

.portfolio-lightbox{position:fixed;inset:0;z-index:200;display:grid;place-items:center;padding:5vw;background:rgba(0,0,0,.9);opacity:0;pointer-events:none;transition:opacity .25s ease}.portfolio-lightbox.is-open{opacity:1;pointer-events:auto}.portfolio-lightbox img{max-width:90vw;max-height:88vh;width:auto;height:auto;object-fit:contain}.portfolio-lightbox button{position:absolute;top:20px;right:28px;border:0;background:none;color:#fff;font-size:36px;line-height:1;cursor:pointer}.lightbox-open{overflow:hidden}
/* BARELYSAIN gallery: one dependable editorial system, scoped away from the core UI. */
#barelysain .campaign-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: clamp(14px, 1.6vw, 26px);
  margin-top: clamp(54px, 8vw, 110px);
  align-items: start;
}
#barelysain .campaign-grid > .asset-frame {
  display: block;
  grid-column: auto;
  width: 100%;
  min-height: 0;
  margin: 0;
  padding: 0;
  aspect-ratio: auto;
  align-self: start;
  background: none;
}
#barelysain .campaign-grid > .asset-frame:first-child {
  grid-column: 1 / -1;
}
#barelysain .campaign-grid img {
  display: block;
  width: 100%;
  height: auto;
  max-height: none;
  object-fit: contain;
}
@media (max-width: 700px) {
  #barelysain .campaign-grid {
    grid-template-columns: 1fr;
  }
  #barelysain .campaign-grid > .asset-frame:first-child {
    grid-column: auto;
  }
}
