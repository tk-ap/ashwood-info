{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "feat/*": false,
      "fix/*": false,
      "design/*": false,
      "content/*": false,
      "direction/*": false,
      "ops/*": false,
      "chore/*": false,
      "docs/*": false
    }
  },
  "github": {
    "autoJobCancelation": true
  },
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ]; then exit 1; else exit 0; fi"
}
